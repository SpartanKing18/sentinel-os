#!/usr/bin/env bash
# Quick "look boring" toggle for XFCE (undercover-lite): switch to a plain light
# theme + neutral wallpaper, or restore the Sentinel dark look. Also a panic mode.
S="$HOME/.config/sentinel/stealth.state"; mkdir -p "$(dirname "$S")"
set_theme(){ xfconf-query -c xsettings -p /Net/ThemeName -s "$1" 2>/dev/null; xfconf-query -c xfwm4 -p /general/theme -s "$1" 2>/dev/null; }
case "${1:-toggle}" in
  on|toggle) set_theme "Adwaita"; xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/color-style -s 0 2>/dev/null; echo stealth > "$S"; echo "[+] stealth ON";;
  off) set_theme "Adwaita-dark"; rm -f "$S"; echo "[+] stealth OFF";;
  panic) xdotool key super+d 2>/dev/null || wmctrl -k on 2>/dev/null; set_theme "Adwaita"; echo "[+] panic";;
  *) echo "usage: sentinel-stealth on|off|panic";;
esac
