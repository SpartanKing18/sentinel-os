#!/usr/bin/env bash
# Natural-language → shell command, then optionally run it. Uses the Sentinel AI engine.
set -uo pipefail
Q="$*"; [ -n "$Q" ] || read -rp "What do you want to do? " Q
CMD="$(sentinel-ai -q -s 'Convert the request into ONE safe shell command for a Debian pentest box. Output ONLY the command — no prose, no backticks, no explanation.' "$Q" | grep -m1 . | sed 's/^`*//;s/`*$//')"
[ -n "$CMD" ] && [ "$CMD" != "null" ] || { echo "no suggestion"; exit 1; }
echo "» $CMD"; read -rp "Run it? [y/N] " a; [ "$a" = y ] && eval "$CMD"
