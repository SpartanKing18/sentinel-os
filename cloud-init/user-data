#cloud-config
# Sentinel OS — a unique, from-scratch security workstation on a neutral Debian
# base. Its own desktop + curated toolset + local-AI autonomy + the Sentinel app
# as the UI cockpit. No Kali packages. Everything installs on first boot.
hostname: sentinel-os
users:
  - name: sentinel
    gecos: Sentinel Operator
    groups: [sudo, kvm]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: false
    passwd: "REPLACED_AT_BUILD_TIME"
chpasswd:
  expire: false
ssh_pwauth: true
package_update: true

write_files:
  - path: /etc/lightdm/lightdm.conf.d/10-sentinel-autologin.conf
    content: |
      [Seat:*]
      autologin-user=sentinel
      autologin-user-timeout=0
      user-session=sentinel
  # A session that guarantees a D-Bus session bus (dbus-run-session) — the minimal
  # cloud base doesn't export DBUS_SESSION_BUS_ADDRESS into the autologin session,
  # which otherwise breaks xfce4-session ("unable to load a failsafe session").
  - path: /usr/share/xsessions/sentinel.desktop
    content: |
      [Desktop Entry]
      Name=Sentinel Desktop
      Comment=Sentinel XFCE session (guaranteed D-Bus)
      Exec=dbus-run-session -- startxfce4
      Type=Application
      DesktopNames=XFCE
  - path: /etc/motd
    content: |

      ███████ ███████ ███    ██ ████████ ██ ███    ██ ███████ ██
      ██      ██      ████   ██    ██    ██ ████   ██ ██      ██
      ███████ █████   ██ ██  ██    ██    ██ ██ ██  ██ █████   ██
           ██ ██      ██  ██ ██    ██    ██ ██  ██ ██ ██      ██
      ███████ ███████ ██   ████    ██    ██ ██   ████ ███████ ███████
        Sentinel OS · agentic security workstation · `sentinel nexus` / Autopilot

  # The Sentinel app is optional (in the menu / on the desktop) — it does NOT
  # auto-launch. The VM's UI is its own branded XFCE desktop. This autostart only
  # applies the Sentinel wallpaper + dark theme once, then removes itself.
  - path: /home/sentinel/.config/autostart/sentinel-desktop-setup.desktop
    content: |
      [Desktop Entry]
      Type=Application
      Name=Sentinel Desktop Setup
      Exec=sentinel-desktop-setup
      X-GNOME-Autostart-enabled=true
    owner: sentinel:sentinel
    defer: true
  # Firefox opens the Sentinel web console as its homepage/bookmark (an "extra",
  # like Kali's docs bookmark) — the app is the primary UI, this is the site.
  - path: /etc/firefox-esr/policies/policies.json
    content: |
      {"policies":{"Homepage":{"URL":"https://sentinel-web-2hq9.onrender.com","StartPage":"homepage"},"OverrideFirstRunPage":"https://sentinel-web-2hq9.onrender.com","DontCheckDefaultBrowser":true,"SearchEngines":{"Default":"Google"},"SearchBar":"unified","Bookmarks":[{"Title":"Sentinel Console","URL":"https://sentinel-web-2hq9.onrender.com","Placement":"toolbar"}]}}
  - path: /usr/local/bin/sentinel-autopilot
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      # Autonomous hacking: a local AI agent plans + runs recon/exploitation toward
      # a goal, using a free local model (Ollama) — offline, no API key. Authorized
      # targets only.
      set -u
      if command -v ollama >/dev/null; then
        pgrep -x ollama >/dev/null || (nohup ollama serve >/dev/null 2>&1 &)
        for _i in $(seq 1 20); do ollama list >/dev/null 2>&1 && break; sleep 1; done
        ollama list 2>/dev/null | grep -qiE "llama3|qwen|mistral" || { echo "[*] pulling a local model (one-time)…"; ollama pull llama3.2:3b || true; }
      fi
      echo "== Sentinel Autopilot — autonomous AI hacking =="
      read -rp "Goal (e.g. 'recon and exploit 10.0.0.5 for a shell'): " GOAL
      [ -n "$GOAL" ] || { echo "no goal given"; exit 1; }
      exec sentinel nexus run "$GOAL" -e ollama
  - path: /usr/local/sbin/sentinel-provision.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -ux
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
      LOG=/var/log/sentinel-provision.log; exec >>"$LOG" 2>&1
      echo "=== Sentinel provision $(date) ==="
      apt-get remove -y needrestart 2>/dev/null || true
      # Enable contrib/non-free (old sources.list AND deb822 debian.sources on Bookworm)
      sed -i 's/ main$/ main contrib non-free non-free-firmware/' /etc/apt/sources.list 2>/dev/null || true
      sed -i '/^Components:/ s/$/ contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true
      apt-get update -y || true
      # Generic kernel (has vboxvideo/vboxguest + full HID/SATA drivers) so the VM
      # works in VirtualBox/VMware, not just virtio-cloud — cursor+graphics need it.
      apt-get install -y linux-image-amd64 && { apt-get purge -y linux-image-cloud-amd64 2>/dev/null || true; }
      update-grub 2>/dev/null || true
      echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections
      # Our own desktop (XFCE) + tools from Debian — installed one-by-one so a
      # single unavailable package can't abort the batch.
      PKGS="xfce4 xfce4-terminal xfce4-goodies xfce4-whiskermenu-plugin lightdm dbus-x11 firefox-esr \
        git curl wget jq unzip build-essential python3 python3-pip pipx nodejs npm \
        nmap masscan dnsutils whois net-tools tcpdump \
        nikto whatweb wafw00f dnsrecon dirb wfuzz gobuster \
        sqlmap hydra john hashcat \
        aircrack-ng wireshark ettercap-graphical \
        radare2 binwalk foremost sleuthkit \
        netcat-traditional python3-impacket \
        tor nftables firejail firejail-profiles apparmor apparmor-utils macchanger \
        proxychains4 torsocks keepassxc gnupg whiptail desktop-file-utils \
        xdotool wmctrl libimage-exiftool-perl arc-theme papirus-icon-theme \
        fonts-inter fonts-jetbrains-mono dmz-cursor-theme xfce4-notifyd kbd \
        docker.io docker-compose-plugin"
      for p in $PKGS; do apt-get install -y "$p" || echo "SKIP $p"; done
      usermod -aG docker sentinel 2>/dev/null || true
      usermod -aG wireshark sentinel 2>/dev/null || true
      systemctl enable --now docker 2>/dev/null || true
      # ---- upstream tools (not in Debian) ----
      # Metasploit (official installer adds its apt repo)
      install -d -m0755 /usr/share/keyrings
      curl -fsSL --max-time 60 https://apt.metasploit.com/metasploit-framework.gpg.key | gpg --dearmor -o /usr/share/keyrings/metasploit.gpg 2>/dev/null || true
      echo "deb [signed-by=/usr/share/keyrings/metasploit.gpg] https://apt.metasploit.com/ lucid main" > /etc/apt/sources.list.d/metasploit.list
      apt-get update -y || true
      timeout 900 apt-get install -y metasploit-framework || echo "MSF-SKIP"
      # SecLists + Exploit-DB (searchsploit)
      [ -d /usr/share/seclists ] || timeout 400 git clone --depth 1 https://github.com/danielmiessler/SecLists /usr/share/seclists || echo SECLISTS-SKIP
      [ -d /opt/exploitdb ] || timeout 300 git clone --depth 1 https://gitlab.com/exploit-database/exploitdb /opt/exploitdb || echo EDB-SKIP
      ln -sf /opt/exploitdb/searchsploit /usr/local/bin/searchsploit 2>/dev/null || true
      # ProjectDiscovery + ffuf via PREBUILT release binaries (no compile, no Go-version issues)
      mkdir -p /tmp/pd
      for repo in projectdiscovery/nuclei projectdiscovery/subfinder projectdiscovery/httpx ffuf/ffuf; do
        url=$(curl -fsSL --max-time 30 "https://api.github.com/repos/$repo/releases/latest" | jq -r '.assets[].browser_download_url' | grep -iE 'linux_amd64\.(zip|tar\.gz)$' | grep -viE 'arm|386|sdk' | head -1)
        [ -n "$url" ] || { echo "PDSKIP $repo"; continue; }
        curl -fsSL --max-time 120 -o /tmp/pd/a "$url" || { echo "PDSKIP $repo"; continue; }
        case "$url" in *.zip) (cd /tmp/pd && unzip -oq a);; *) tar xzf /tmp/pd/a -C /tmp/pd 2>/dev/null;; esac
        for f in /tmp/pd/*; do [ "$f" = /tmp/pd/a ] && continue; file "$f" 2>/dev/null | grep -q ELF && install -m0755 "$f" /usr/local/bin/; rm -f "$f"; done
        rm -f /tmp/pd/a
      done
      timeout 240 pipx install netexec 2>/dev/null || echo NXC-SKIP; pipx ensurepath 2>/dev/null || true
      # Local AI for autonomous hacking
      timeout 300 bash -c "curl -fsSL https://ollama.com/install.sh | sh" || echo OLLAMA-SKIP
      systemctl enable --now ollama 2>/dev/null || true
      # Sentinel app (latest .deb) + Nexus CLI
      DEB_URL=$(curl -fsSL https://api.github.com/repos/SpartanKing18/sentinel-web/releases/tags/sentinel | jq -r '.assets[].browser_download_url' | grep -E 'sentinel-app_.*_amd64\.deb' | sort -V | tail -1)
      if [ -n "$DEB_URL" ]; then curl -fL --max-time 180 "$DEB_URL" -o /tmp/sentinel-app.deb; apt-get install -y /tmp/sentinel-app.deb || { dpkg -i /tmp/sentinel-app.deb || true; apt-get -f install -y; }; fi
      [ -d /opt/sentinel-cli ] || timeout 180 git clone --depth 1 https://github.com/SpartanKing18/sentinel-cli /opt/sentinel-cli
      ( cd /opt/sentinel-cli && { timeout 300 npm install --omit=dev --no-audit --no-fund || timeout 300 npm install --no-audit --no-fund || true; }; npm link || ln -sf /opt/sentinel-cli/sentinel.js /usr/local/bin/sentinel )
      chmod +x /opt/sentinel-cli/sentinel.js || true
      # Sentinel toolkit — adopted-and-improved distro features + unique AI tools
      for s in sentinel-anon sentinel-macspoof sentinel-detonate sentinel-stealth \
               sentinel-ask sentinel-triage sentinel-engage sentinel-arsenal \
               sentinel-tweaks gen-sentinel-menu sentinel-desktop-setup; do
        curl -fsSL "https://raw.githubusercontent.com/SpartanKing18/sentinel-os/main/toolkit/$s" -o "/usr/local/bin/$s" && chmod +x "/usr/local/bin/$s" || echo "TOOLKIT-SKIP $s"
      done
      command -v firecfg >/dev/null && firecfg >/dev/null 2>&1 || true   # auto-sandbox common apps
      gen-sentinel-menu 2>/dev/null || true
      install -d /usr/share/backgrounds; curl -fsSL "https://raw.githubusercontent.com/SpartanKing18/sentinel-os/main/toolkit/sentinel-wallpaper.png" -o /usr/share/backgrounds/sentinel-wallpaper.png 2>/dev/null || true
      install -d /usr/share/pixmaps; curl -fsSL "https://raw.githubusercontent.com/SpartanKing18/sentinel-os/main/toolkit/google-icon.png" -o /usr/share/pixmaps/sentinel-google.png 2>/dev/null || true
      curl -fsSL "https://raw.githubusercontent.com/SpartanKing18/sentinel-os/main/toolkit/sentinel-menu.png" -o /usr/share/pixmaps/sentinel-menu.png 2>/dev/null || true
      # branded LightDM login screen (dark, Sentinel wallpaper, teal accent)
      cat > /etc/lightdm/lightdm-gtk-greeter.conf <<'GRE'
      [greeter]
      theme-name = Arc-Dark
      icon-theme-name = Papirus-Dark
      font-name = Inter 11
      cursor-theme-name = DMZ-White
      cursor-theme-size = 24
      background = /usr/share/backgrounds/sentinel-wallpaper.png
      xft-antialias = true
      xft-hintstyle = hintslight
      xft-rgba = rgb
      indicators = ~host;~spacer;~clock;~spacer;~session;~power
      clock-format = %A  %d %B    %H:%M
      position = 50%,center 58%,center
      GRE
      sed -i 's/^      //' /etc/lightdm/lightdm-gtk-greeter.conf
      # Make the image bootable on ANY hypervisor disk controller (VirtualBox
      # SATA/AHCI, VMware) — the Debian cloud initramfs is virtio-only by default.
      sed -i 's/^MODULES=.*/MODULES=most/' /etc/initramfs-tools/initramfs.conf 2>/dev/null || echo "MODULES=most" >> /etc/initramfs-tools/initramfs.conf
      update-initramfs -u 2>/dev/null || true
      # Desktop cockpit shortcuts
      install -d -o sentinel -g sentinel /home/sentinel/Desktop
      cat > /home/sentinel/Desktop/Sentinel.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Sentinel (cockpit)
      Exec=sentinel-app
      Terminal=false
      D
      cat > /home/sentinel/Desktop/Autopilot.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Sentinel Autopilot
      Comment=Autonomous AI hacking — give a goal, the local agent runs it
      Exec=xfce4-terminal --title="Sentinel Autopilot" -e sentinel-autopilot
      Terminal=false
      D
      cat > /home/sentinel/Desktop/Sentinel-Tweaks.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Sentinel Tweaks
      Comment=Control center — anon mode, stealth, MAC spoof, arsenals, AI triage
      Exec=xfce4-terminal --title="Sentinel Tweaks" -e sentinel-tweaks
      Terminal=false
      D
      chown sentinel:sentinel /home/sentinel/Desktop/*.desktop 2>/dev/null || true
      chmod +x /home/sentinel/Desktop/*.desktop 2>/dev/null || true
      # cloud-init write_files ran as root and left parts of the home root-owned
      # (esp. ~/.config), which breaks xfconfd -> the XFCE session. Fix ownership.
      chown -R sentinel:sentinel /home/sentinel
      # MAC-agnostic network so it works in VirtualBox/any hypervisor (the default
      # cloud netplan pins a MAC), and stop cloud-init from regenerating it.
      printf 'network:\n  version: 2\n  ethernets:\n    sentinel-any:\n      match:\n        name: "e*"\n      dhcp4: true\n      dhcp6: false\n' > /etc/netplan/50-cloud-init.yaml
      chmod 600 /etc/netplan/50-cloud-init.yaml
      echo 'network: {config: disabled}' > /etc/cloud/cloud.cfg.d/99-disable-network.cfg
      touch /var/lib/sentinel-provisioned
      echo "=== provision done $(date) ==="

runcmd:
  - [ bash, -c, "echo 'datasource_list: [ NoCloud, ConfigDrive, None ]' > /etc/cloud/cloud.cfg.d/99-nocloud.cfg" ]
  - [ bash, /usr/local/sbin/sentinel-provision.sh ]
  - [ systemctl, enable, lightdm ]
  - [ systemctl, set-default, graphical.target ]
  - [ systemctl, start, lightdm ]

final_message: "Sentinel OS ready after $UPTIME s. Login: sentinel / sentinel."
