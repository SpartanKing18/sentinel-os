#!/usr/bin/env bash
# First-login desktop branding for Sentinel OS — wallpaper + dark theme. Self-removes.
set -u
WALL=/usr/share/backgrounds/sentinel-wallpaper.png
for i in $(seq 1 20); do xfconf-query -c xfce4-desktop -l >/dev/null 2>&1 && break; sleep 1; done
# dark theme — pick the best that is ACTUALLY installed (a missing theme name
# silently falls back to light Adwaita, so check the dirs rather than trusting -s).
TH=Adwaita-dark; [ -d /usr/share/themes/Arc-Dark ] && TH=Arc-Dark
IC=Adwaita;      [ -d /usr/share/icons/Papirus-Dark ] && IC=Papirus-Dark
xfconf-query -c xsettings -p /Net/ThemeName     -n -t string -s "$TH" 2>/dev/null
xfconf-query -c xfwm4     -p /general/theme      -n -t string -s "$TH" 2>/dev/null
xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$IC" 2>/dev/null

# --- professional polish: crisp fonts, modern cursor, window depth ---
UIFONT="DejaVu Sans 10"; fc-list 2>/dev/null | grep -qi "Inter"     && UIFONT="Inter 10"
MONO="DejaVu Sans Mono 10"; fc-list 2>/dev/null | grep -qi "JetBrains" && MONO="JetBrains Mono 10"
CUR=Adwaita; [ -d /usr/share/icons/DMZ-White ] && CUR=DMZ-White
xfconf-query -c xsettings -p /Gtk/FontName          -n -t string -s "$UIFONT" 2>/dev/null
xfconf-query -c xsettings -p /Gtk/MonospaceFontName -n -t string -s "$MONO" 2>/dev/null
xfconf-query -c xsettings -p /Xft/Antialias -n -t int    -s 1 2>/dev/null
xfconf-query -c xsettings -p /Xft/Hinting   -n -t int    -s 1 2>/dev/null
xfconf-query -c xsettings -p /Xft/HintStyle -n -t string -s "hintslight" 2>/dev/null
xfconf-query -c xsettings -p /Xft/RGBA      -n -t string -s "rgb" 2>/dev/null
xfconf-query -c xsettings -p /Xft/DPI       -n -t int    -s 96 2>/dev/null
xfconf-query -c xsettings -p /Gtk/CursorThemeName -n -t string -s "$CUR" 2>/dev/null
xfconf-query -c xsettings -p /Gtk/CursorThemeSize -n -t int    -s 24 2>/dev/null
# window manager: clean right-side buttons. NOTE compositing is intentionally OFF —
# in a software-rendered VM the compositor is the #1 cause of scroll/cursor/type lag.
xfconf-query -c xfwm4 -p /general/title_font       -n -t string -s "${UIFONT% *} Bold ${UIFONT##* }" 2>/dev/null
xfconf-query -c xfwm4 -p /general/button_layout    -s "O|HMC" 2>/dev/null
xfconf-query -c xfwm4 -p /general/title_alignment  -n -t string -s "center" 2>/dev/null
xfconf-query -c xfwm4 -p /general/use_compositing  -n -t bool -s false 2>/dev/null
xfconf-query -c xfwm4 -p /general/show_frame_shadow -n -t bool -s false 2>/dev/null
xfconf-query -c xfwm4 -p /general/show_popup_shadow -n -t bool -s false 2>/dev/null
xfconf-query -c xfwm4 -p /general/box_move         -n -t bool -s true 2>/dev/null
xfconf-query -c xfwm4 -p /general/box_resize       -n -t bool -s true 2>/dev/null
xfconf-query -c xfwm4 -p /general/focus_delay      -n -t int  -s 0 2>/dev/null
# smoothness: no GTK animations / event sounds / on-the-fly thumbnailing in a VM
xfconf-query -c xsettings -p /Gtk/EnableAnimations -n -t bool -s false 2>/dev/null
xfconf-query -c xsettings -p /Net/EnableEventSounds -n -t bool -s false 2>/dev/null
xfconf-query -c thunar    -p /misc-thumbnail-mode  -n -t string -s "THUNAR_THUMBNAIL_MODE_NEVER" 2>/dev/null

# --- professional dark terminal (JetBrains Mono, teal-accent palette) ---
mkdir -p "$HOME/.config/xfce4/terminal"
cat > "$HOME/.config/xfce4/terminal/terminalrc" <<'RC'
[Configuration]
FontName=JetBrains Mono 12
FontAllowBold=TRUE
MiscMenubarDefault=FALSE
MiscToolbarDefault=FALSE
MiscBordersDefault=TRUE
MiscDefaultGeometry=104x28
MiscConfirmClose=TRUE
MiscHighlightUrls=TRUE
MiscCursorShape=TERMINAL_CURSOR_SHAPE_BLOCK
MiscCursorBlinks=FALSE
CellHeightScale=1.060000
CellWidthScale=1.000000
ScrollingBar=TERMINAL_SCROLLBAR_NONE
ScrollingUnlimited=TRUE
BackgroundMode=TERMINAL_BACKGROUND_SOLID
ColorForeground=#d6dee8
ColorBackground=#0d1117
ColorCursor=#1ce0d0
ColorCursorForeground=#0d1117
ColorBold=#ffffff
ColorBoldUseDefault=FALSE
ColorSelection=#0d1117
ColorSelectionUseDefault=FALSE
ColorSelectionBackground=#1ce0d0
TabActivityColor=#1ce0d0
ColorPalette=#5b6672;#ff7b72;#3fb950;#e3b341;#58a6ff;#bc8cff;#39c5cf;#c9d1d9;#6e7681;#ffa198;#56d364;#f2cc60;#79c0ff;#d2a8ff;#56d4dd;#ffffff
RC

# --- disable the disruptive idle screen-lock (light-locker spawns a separate
#     greeter on another VT); keep manual lock available via the menu ---
mkdir -p "$HOME/.config/autostart"
cat > "$HOME/.config/autostart/light-locker.desktop" <<'D'
[Desktop Entry]
Type=Application
Name=Screen Locker
Exec=light-locker
Hidden=true
X-GNOME-Autostart-enabled=false
D
xfconf-query -c xfce4-screensaver -p /saver/enabled -n -t bool -s false 2>/dev/null || true
xfconf-query -c xfce4-screensaver -p /lock/enabled  -n -t bool -s false 2>/dev/null || true

# wallpaper on all existing backdrop props + monitor0/Virtual-1 fallbacks
if [ -f "$WALL" ]; then
  while read -r p; do [ -n "$p" ] && xfconf-query -c xfce4-desktop -p "$p" -s "$WALL" 2>/dev/null; done < <(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E 'last-image$')
  for m in monitor0 monitorVirtual-1 monitorVirtual1; do
    xfconf-query -c xfce4-desktop -p "/backdrop/screen0/$m/workspace0/last-image" -n -t string -s "$WALL" 2>/dev/null
    xfconf-query -c xfce4-desktop -p "/backdrop/screen0/$m/workspace0/image-style" -n -t int -s 5 2>/dev/null
  done
  xfdesktop --reload 2>/dev/null
fi

# --- Kali-style single top panel: launchers up top + a Google web-search button ---
GICON=/usr/share/pixmaps/sentinel-google.png
[ -f "$GICON" ] || GICON=web-browser   # graceful fallback icon name
mkdir -p "$HOME/.config/xfce4/panel/launcher-23"
cat > "$HOME/.config/xfce4/panel/launcher-23/google.desktop" <<DESK
[Desktop Entry]
Version=1.0
Type=Application
Name=Google Search
Comment=Search the web with Google
Exec=firefox-esr https://www.google.com
Icon=$GICON
Terminal=false
StartupNotify=false
Categories=Network;WebBrowser;
DESK
# register the Google launcher as panel plugin 23 (idempotent)
xfconf-query -c xfce4-panel -p /plugins/plugin-23 -n -t string -s launcher 2>/dev/null || \
  xfconf-query -c xfce4-panel -p /plugins/plugin-23 -t string -s launcher 2>/dev/null
xfconf-query -c xfce4-panel -p /plugins/plugin-23/items -n -t string -s google.desktop -a 2>/dev/null || \
  xfconf-query -c xfce4-panel -p /plugins/plugin-23/items -t string -s google.desktop -a 2>/dev/null
# --- Whisker menu (searchable, Kali-style) as plugin-24, branded "Sentinel" ---
# Whisker stores its own settings in an .rc file, NOT xfconf, so write both.
if [ -x /usr/lib/x86_64-linux-gnu/xfce4/panel/plugins/libwhiskermenu.so ] || \
   ls /usr/lib/*/xfce4/panel/plugins/libwhiskermenu.so >/dev/null 2>&1; then
  MICON=/usr/share/pixmaps/sentinel-menu.png
  [ -f "$MICON" ] || MICON=start-here
  xfconf-query -c xfce4-panel -p /plugins/plugin-24 -n -t string -s whiskermenu 2>/dev/null
  cat > "$HOME/.config/xfce4/panel/whiskermenu-24.rc" <<RCEOF
favorites=exo-open --launch TerminalEmulator,firefox-esr.desktop,exo-open --launch FileManager
recent=
button-title=Sentinel
button-icon=$MICON
show-button-title=true
show-button-icon=true
show-command-settings=true
show-command-lockscreen=true
show-command-logout=true
category-show-name=true
launcher-show-name=true
launcher-show-description=true
position-search-alternate=true
position-commands-alternate=true
menu-width=500
menu-height=550
RCEOF
  MENU=24
else
  MENU=1   # fall back to the stock applications menu
fi

# top panel order: [Sentinel menu] terminal browser files GOOGLE | sep | tasklist pager | tray... | clock | actions
# (stock XFCE plugin ids: 17=terminal 18=files 19=browser)
if xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids >/dev/null 2>&1; then
  xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids -a \
    -t int -s "$MENU" -t int -s 17 -t int -s 19 -t int -s 18 -t int -s 23 \
    -t int -s 3 -t int -s 2 -t int -s 4 -t int -s 5 -t int -s 6 \
    -t int -s 8 -t int -s 9 -t int -s 10 -t int -s 11 -t int -s 12 -t int -s 13 -t int -s 14 2>/dev/null
  # taller bar + bigger launcher icons + dark, translucent, teal-tinted background
  xfconf-query -c xfce4-panel -p /panels/panel-1/size -n -t int -s 40 2>/dev/null
  xfconf-query -c xfce4-panel -p /panels/panel-1/icon-size -n -t int -s 30 2>/dev/null
  xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -n -t int -s 1 2>/dev/null
  xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n -a \
    -t double -s 0.035 -t double -s 0.086 -t double -s 0.110 -t double -s 0.94 2>/dev/null
  # clean clock (date + 24h time)
  xfconf-query -c xfce4-panel -p /plugins/plugin-12/digital-time-format -n -t string -s "%H:%M" 2>/dev/null || true
  xfconf-query -c xfce4-panel -p /plugins/plugin-12/digital-date-format -n -t string -s "%a %d %b" 2>/dev/null || true
  # collapse to a single top panel (drop the bottom dock)
  xfconf-query -c xfce4-panel -p /panels -a -t int -s 1 2>/dev/null
  xfce4-panel -r 2>/dev/null || true
fi

# --- trust the desktop launchers so xfdesktop stops the "Untrusted application
#     launcher" prompt on every double-click. It stores a SHA-256 of the file in
#     gvfs metadata (metadata::xfce-exe-checksum) — exactly what "Mark Executable"
#     does. Needs gio (libglib2.0-bin) and the live session bus (both present here). ---
if command -v gio >/dev/null 2>&1; then
  for f in "$HOME"/Desktop/*.desktop; do
    [ -e "$f" ] || continue
    chmod +x "$f" 2>/dev/null
    gio set -t string "$f" metadata::xfce-exe-checksum "$(sha256sum "$f" | cut -d' ' -f1)" 2>/dev/null || true
  done
fi

rm -f "$HOME/.config/autostart/sentinel-desktop-setup.desktop"
