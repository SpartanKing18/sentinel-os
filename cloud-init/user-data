#cloud-config
# Sentinel OS — self-provisioning Kali workstation.
# Boots the Kali generic cloud image into an XFCE desktop (Kali menu + theme +
# undercover), auto-launches the Sentinel app, Nexus CLI on PATH, curated
# pentest toolset. Everything installs on first boot.
hostname: sentinel-os
users:
  - name: sentinel
    gecos: Sentinel Operator
    groups: [sudo, kvm]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
    lock_passwd: false
    passwd: "REPLACED_AT_BUILD_TIME"
chpasswd:
  expire: false
ssh_pwauth: true
package_update: true

write_files:
  - path: /etc/lightdm/lightdm.conf.d/10-sentinel-autologin.conf
    content: |
      [Seat:*]
      autologin-user=sentinel
      autologin-user-timeout=0
      user-session=xfce
  - path: /home/sentinel/.config/autostart/sentinel-app.desktop
    content: |
      [Desktop Entry]
      Type=Application
      Name=Sentinel
      Exec=sentinel-app
      X-GNOME-Autostart-enabled=true
    owner: sentinel:sentinel
    defer: true
  - path: /home/sentinel/.config/autostart/nexus.desktop
    content: |
      [Desktop Entry]
      Type=Application
      Name=Nexus
      Exec=xfce4-terminal --title=Nexus -e "bash -lc 'sentinel nexus || bash'"
      X-GNOME-Autostart-enabled=true
    owner: sentinel:sentinel
    defer: true
  - path: /usr/local/sbin/sentinel-provision.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -ux
      export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
      LOG=/var/log/sentinel-provision.log; exec >>"$LOG" 2>&1
      echo "=== Sentinel provision $(date) ==="
      apt-get update -y || true
      apt-get remove -y needrestart 2>/dev/null || true
      # wireshark setuid: answer the debconf prompt up front (headless-safe)
      echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections
      # Desktop (Kali XFCE + menu taxonomy + theme + undercover) and curated tools.
      # Installed one-by-one so a single unavailable package can't abort the batch.
      PKGS="kali-desktop-xfce lightdm kali-menu kali-themes kali-undercover firefox-esr \
        git curl wget jq nodejs npm python3 python3-pip build-essential \
        nmap theharvester dnsrecon dnsutils whois net-tools \
        nikto whatweb wpscan nuclei \
        ffuf gobuster sqlmap \
        john hashcat hydra seclists wordlists \
        aircrack-ng \
        radare2 exploitdb \
        wireshark tcpdump ettercap-graphical responder \
        netcat-traditional python3-impacket impacket-scripts \
        binwalk foremost sleuthkit \
        metasploit-framework \
        docker.io docker-compose-v2"
      for p in $PKGS; do apt-get install -y --no-install-recommends "$p" || echo "SKIP $p"; done
      # Metasploit DB init at build time so first launch is fast
      ( systemctl enable --now postgresql 2>/dev/null; msfdb init 2>/dev/null ) || true
      # Docker practice lab
      systemctl enable --now docker 2>/dev/null || true
      usermod -aG docker sentinel || true
      # Sentinel app — latest .deb from the rolling 'sentinel' release
      DEB_URL=$(curl -fsSL https://api.github.com/repos/SpartanKing18/sentinel-web/releases/tags/sentinel \
        | jq -r '.assets[].browser_download_url' | grep -E 'sentinel-app_.*_amd64\.deb' | sort -V | tail -1)
      if [ -n "$DEB_URL" ]; then
        curl -fL "$DEB_URL" -o /tmp/sentinel-app.deb
        apt-get install -y /tmp/sentinel-app.deb || { dpkg -i /tmp/sentinel-app.deb || true; apt-get -f install -y; }
      fi
      # Nexus CLI
      [ -d /opt/sentinel-cli ] || git clone --depth 1 https://github.com/SpartanKing18/sentinel-cli /opt/sentinel-cli
      ( cd /opt/sentinel-cli && { npm install --omit=dev --no-audit --no-fund || npm install --no-audit --no-fund; }; npm link || ln -sf /opt/sentinel-cli/sentinel.js /usr/local/bin/sentinel )
      chmod +x /opt/sentinel-cli/sentinel.js || true
      # Desktop shortcuts
      install -d -o sentinel -g sentinel /home/sentinel/Desktop
      cat > /home/sentinel/Desktop/Sentinel.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Sentinel
      Exec=sentinel-app
      Terminal=false
      D
      cat > /home/sentinel/Desktop/Practice-Lab.desktop <<'D'
      [Desktop Entry]
      Type=Application
      Name=Practice Lab
      Exec=xfce4-terminal --title="Practice Lab" -e "bash -lc 'echo Bring up vulnerable targets with:; echo \"  sentinel lab up\"; sentinel lab doctor 2>/dev/null; exec bash'"
      Terminal=false
      D
      chown sentinel:sentinel /home/sentinel/Desktop/*.desktop 2>/dev/null || true
      chmod +x /home/sentinel/Desktop/*.desktop 2>/dev/null || true
      touch /var/lib/sentinel-provisioned
      echo "=== provision done $(date) ==="

runcmd:
  - [ bash, -c, "echo 'datasource_list: [ NoCloud, ConfigDrive, None ]' > /etc/cloud/cloud.cfg.d/99-nocloud.cfg" ]
  - [ bash, /usr/local/sbin/sentinel-provision.sh ]
  - [ systemctl, enable, lightdm ]
  - [ systemctl, set-default, graphical.target ]
  - [ systemctl, start, lightdm ]

final_message: "Sentinel OS (Kali) ready after $UPTIME s. Login: sentinel / sentinel."
