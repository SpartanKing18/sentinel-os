#!/usr/bin/env bash
# sentinel-harvest — passive OSINT harvester (a Sentinel take on theHarvester).
# Given a domain it gathers: subdomains (certificate transparency), DNS + mail records,
# mail-security posture (SPF/DMARC), live-host resolution, and a likely email format —
# then the local AI turns it into an attack-surface brief. 100% passive, no API keys.
# Authorized targets only.
set -uo pipefail
D="${1:-}"; [ -n "$D" ] || { echo "usage: sentinel-harvest <domain>"; exit 1; }
D="${D#*://}"; D="${D%%/*}"                       # accept a URL too
command -v sentinel-scope >/dev/null && { sentinel-scope guard "$D" || exit 3; }
DIR="$HOME/engagements/${D//[^A-Za-z0-9._-]/_}-osint-$(date -u +%Y%m%d-%H%M%S)"; mkdir -p "$DIR"
OUT="$DIR/harvest.txt"; : > "$OUT"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
log(){ printf '%s\n' "$*" | tee -a "$OUT"; }

c "== Sentinel Harvest · $D =="

# 1) subdomains via certificate transparency (crt.sh) — passive, free
c "→ subdomains (crt.sh certificate transparency)…"
Dlc="$(printf '%s' "$D" | tr 'A-Z' 'a-z')"; Dre="${Dlc//./\\.}"   # lowercased + dots escaped for the regex
SUBS="$(curl -fsS --max-time 30 "https://crt.sh/?q=%25.$D&output=json" 2>/dev/null \
  | tr ',{}[]' '\n' | grep -oE '"(common_name|name_value)":"[^"]+"' | cut -d'"' -f4 \
  | sed 's/\\n/\n/g' | tr 'A-Z' 'a-z' | sed 's/\*\.//' | grep -E "(^|\.)$Dre\$" | sort -u)"
printf '%s\n' "$SUBS" > "$DIR/subdomains.txt"
{ echo "== SUBDOMAINS =="; printf '%s\n' "$SUBS" | head -60; } >> "$OUT"   # so the AI brief actually sees them
NSUB=$(printf '%s\n' "$SUBS" | grep -c . || true)
log "[subdomains] $NSUB found"; printf '%s\n' "$SUBS" | sed 's/^/  /' | head -40
[ "${NSUB:-0}" -gt 40 ] && log "  … $((NSUB-40)) more in $DIR/subdomains.txt"

# 2) DNS + mail records
c "→ DNS + mail records…"
{ echo "== A ==";  dig +short "$D" A
  echo "== NS =="; dig +short "$D" NS
  echo "== MX =="; dig +short "$D" MX
  echo "== TXT =="; dig +short "$D" TXT; } | tee -a "$OUT"
SPF="$(dig +short "$D" TXT | grep -i 'v=spf1' | head -1)"
DMARC="$(dig +short _dmarc."$D" TXT | grep -i 'v=DMARC1' | head -1)"
log "[mail-security] SPF: ${SPF:-MISSING}    DMARC: ${DMARC:-MISSING}"

# 3) resolve subdomains to live hosts (capped)
c "→ resolving subdomains to live hosts…"
LIVE="$DIR/live-hosts.txt"; : > "$LIVE"; i=0
while IFS= read -r s; do [ -z "$s" ] && continue; i=$((i+1)); [ "$i" -gt 80 ] && break
  ip="$(dig +time=2 +tries=1 +short "$s" A | grep -E '^[0-9]' | head -1)"; [ -n "$ip" ] && printf '%s -> %s\n' "$s" "$ip" >> "$LIVE"
done <<< "$SUBS"
log "[live-hosts] $(grep -c . "$LIVE" 2>/dev/null || echo 0) resolvable (→ $LIVE)"
{ echo "== LIVE HOSTS =="; head -40 "$LIVE"; } >> "$OUT" 2>/dev/null   # feed the AI the actual hosts
head -20 "$LIVE" 2>/dev/null | sed 's/^/  /'

# 4) likely corporate email format (inference — no scraping)
log "[emails] likely formats: {first}.{last}@$D · {f}{last}@$D · {first}@$D"

# 5) Wayback Machine — archived URLs (passive; surfaces old endpoints/params/files)
c "→ Wayback Machine archived URLs…"
WB="$(curl -fsS --max-time 25 "http://web.archive.org/cdx/search/cdx?url=$D/*&output=text&fl=original&collapse=urlkey&limit=400" 2>/dev/null | sort -u)"
printf '%s\n' "$WB" > "$DIR/wayback-urls.txt"
NWB=$(printf '%s\n' "$WB" | grep -c . || true)
log "[wayback] $NWB archived URLs (→ wayback-urls.txt); interesting ones:"
printf '%s\n' "$WB" | grep -iE '\?|/api/|admin|login|logout|upload|config|backup|\.env|\.sql|\.bak|\.json|token|key' | head -15 | sed 's/^/  ! /' | tee -a "$OUT"

# 6) ASN / netblock (Team Cymru whois — passive; expands to the org's IP space)
c "→ ASN / netblock…"
IP1="$(dig +short "$D" A | grep -E '^[0-9]' | head -1)"
if [ -n "$IP1" ]; then
  ASN="$(whois -h whois.cymru.com " -v $IP1" 2>/dev/null | tail -1 | tr -s ' ')"
  log "[asn] $IP1 → $ASN"
  ORG="$(whois "$IP1" 2>/dev/null | grep -iE '^(netrange|cidr|orgname|org-name|netname|descr):' | head -5 | sed 's/^/    /')"
  [ -n "$ORG" ] && printf '%s\n' "$ORG" | tee -a "$OUT"
fi

# 7) GitHub exposure (public search; richer with GITHUB_TOKEN for code/secret search)
c "→ GitHub exposure…"
GH_AUTH=(); [ -n "${GITHUB_TOKEN:-}" ] && GH_AUTH=(-H "Authorization: Bearer $GITHUB_TOKEN")
GHR="$(curl -fsS --max-time 20 "${GH_AUTH[@]}" "https://api.github.com/search/repositories?q=$D&per_page=8" 2>/dev/null | jq -r '.items[]?.full_name' 2>/dev/null)"
log "[github] repos mentioning $D:"; printf '%s\n' "$GHR" | grep -v '^$' | sed 's/^/    /' | tee -a "$OUT" | head
if [ -n "${GITHUB_TOKEN:-}" ]; then
  GHC="$(curl -fsS --max-time 20 "${GH_AUTH[@]}" "https://api.github.com/search/code?q=$D&per_page=8" 2>/dev/null | jq -r '.items[]? | "    "+.repository.full_name+" — "+.path' 2>/dev/null)"
  [ -n "$GHC" ] && { log "[github] code hits (possible leaks):"; printf '%s\n' "$GHC" | tee -a "$OUT"; }
else
  log "    (export GITHUB_TOKEN to enable code search for leaked secrets/config)"
fi

# 8) AI attack-surface brief
c "== Sentinel AI · attack surface =="
if command -v sentinel-ai >/dev/null; then
  head -c 8000 "$OUT" | sentinel-ai -s "You are a red-team OSINT analyst turning passive recon into an attack-surface brief." \
    "Domain: $D. From this passive OSINT produce, in Markdown: (1) the external attack surface — the subdomains/hosts most worth probing and why; (2) interesting archived endpoints/files from the Wayback URLs worth revisiting; (3) mail-security gaps (SPF/DMARC) + spoofing/phishing risk; (4) the ASN/netblock and whether it implies more org-owned IP space to enumerate; (5) any GitHub exposure worth investigating; (6) the 5 highest-value next recon actions with EXACT commands; (7) the likely corporate email format. Be concrete." | tee "$DIR/analysis.md"
else
  log "(install the sentinel-ai engine for the AI attack-surface brief)"
fi
c "[+] saved → $DIR  (subdomains.txt · live-hosts.txt · analysis.md)"
